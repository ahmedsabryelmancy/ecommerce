# URL of the backend API (no trailing slash).
#
# Local development: point at the local Express server (or just rely on the
# Vite dev proxy, which forwards /api -> localhost:5000 without this var).
VITE_API_URL=http://localhost:5000
#
# Production (unified Vercel deploy): LEAVE THIS UNSET.
# Frontend and backend share one domain, so the API client uses same-origin
# relative paths (/api/...). Do NOT set VITE_API_URL in the Vercel project.
