# MongoDB connection string (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ahmed-store?retryWrites=true&w=majority

# JWT secret — use a long random string in production
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Port for local development (Vercel ignores this)
PORT=5000

# Public base URLs used for payment-gateway callbacks.
# SERVER_URL must be publicly reachable so Paymob can deliver the webhook
# (use an ngrok/tunnel URL in local dev). FRONTEND_URL is where the shopper
# is redirected after paying.
SERVER_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Paymob (Accept) payment gateway ──────────────────────────────────────
# Dashboard → Settings → Account Info / Payment Integrations.
# Online card/wallet payments are disabled until these are set; COD always works.
PAYMOB_API_BASE=https://accept.paymob.com
PAYMOB_SECRET_KEY=egy_sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMOB_PUBLIC_KEY=egy_pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMOB_HMAC_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMOB_CURRENCY=EGP
# Integration IDs per method (comma-separate to offer multiple under one method).
PAYMOB_CARD_INTEGRATION_ID=123456
PAYMOB_WALLET_INTEGRATION_ID=123457
